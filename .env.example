# Copy to .env and adjust. Never commit .env.
# Local Docker Postgres runs on host port 5433 (5432 is reserved for another local Postgres).
DATABASE_URL=postgresql://vyayam:vyayam@localhost:5433/vyayam
TEST_DATABASE_URL=postgresql://vyayam:vyayam@localhost:5433/vyayam_test
ENVIRONMENT=development
# Local dev runs on plain http://localhost. Safari won't store "Secure" cookies there,
# so turn it off locally. Production (HTTPS) keeps the default: true.
COOKIE_SECURE=false
